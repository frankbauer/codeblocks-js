.random-tag-placeholder, .template-tag-placeholder, .template-tag-placeholder-noclick
  position relative
  padding-bottom 0px
  padding-top 0px

span.random-tag-placeholder, span.random-tag-placeholder > span, span.random-tag-placeholder > span > span
  //color theme('colors.slate.100')!important

span.random-tag-placeholder
  //background-color theme('colors.blue.100')!important
  border: 1px solid theme('colors.blue.500')
  border-radius 4px
  //box-shadow: 0px 0px 3px theme('colors.blue.800')
  padding 1px 1px

span.random-tag-placeholder.tag-not-found, span.random-tag-placeholder.tag-not-found > span, span.random-tag-placeholder.tag-not-found > span > span
  //color theme('colors.red.200')!important

span.random-tag-placeholder.tag-not-found
  //background-color theme('colors.red.100')!important
  border: 1px dashed theme('colors.red.800')
  box-shadow: none
  font-weight bold


div.tagItem
  border 1px solid theme('colors.blue.700')
  border-radius 3px
  box-shadow 1px 1px 3px rgba(0, 0, 0, 0.2)
